{
  "name": "polar-rift",
  "private": true,
  "version": "2.0.0",
  "description": "Polar Rift — jeu d'arcade web : inversez la direction de votre vaisseau en orbite pour éviter les dangers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:beta": "tsc --noEmit && vite build --mode beta --outDir dist-beta",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/balance.ts",
    "e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "perf": "node scripts/perf.mjs",
    "sprites": "python3 scripts/process-sprites.py",
    "music-map": "python3 -I scripts/analyze-music.py",
    "cost": "vite-node scripts/cost.ts",
    "server": "tsx server/index.ts",
    "server:admin": "tsx server/admin.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "e2e:classement": "node scripts/e2e-classement.mjs"
  },
  "dependencies": {
    "@fontsource/orbitron": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-node": "6.0.0",
    "vitest": "5.0.3"
  }
}
