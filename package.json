{
  "name": "polarite",
  "private": true,
  "version": "1.1.0",
  "description": "Polarité — jeu d'arcade web : inversez la direction de votre vaisseau en orbite pour éviter les dangers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/balance.ts",
    "e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "perf": "node scripts/perf.mjs",
    "sprites": "python3 scripts/process-sprites.py",
    "cost": "vite-node scripts/cost.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-node": "6.0.0",
    "vitest": "5.0.3"
  }
}
