{
  "name": "polar-rift",
  "private": true,
  "version": "2.0.0",
  "description": "Polar Rift — jeu d'arcade web : inversez la direction de votre vaisseau en orbite pour éviter les dangers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:beta": "tsc --noEmit && vite build --mode beta --outDir dist-beta",
    "build:native": "tsc --noEmit && vite build --mode native --outDir dist-native",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/balance.ts",
    "e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "perf": "node scripts/perf.mjs",
    "sprites": "python3 scripts/process-sprites.py",
    "music-map": "python3 -I scripts/analyze-music.py",
    "cost": "vite-node scripts/cost.ts",
    "server": "tsx server/index.ts",
    "server:admin": "tsx server/admin.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "e2e:classement": "node scripts/e2e-classement.mjs",
    "mobile:icons": "python3 -I scripts/make-mobile-icons.py",
    "mobile:assets": "npx --yes @capacitor/assets@3.0.5 generate --iosProject ios/App --androidProject android --assetPath assets --splashBackgroundColor \"#070b1f\" --splashBackgroundColorDark \"#070b1f\" --iconBackgroundColor \"#070b1f\" --iconBackgroundColorDark \"#070b1f\"",
    "mobile:sync": "npm run build:native && node scripts/check-bundle.mjs dist-native && cap sync",
    "mobile:set-id": "tsx scripts/mobile-config.ts set-id",
    "mobile:version": "tsx scripts/mobile-config.ts version",
    "mobile:bump": "tsx scripts/mobile-config.ts bump",
    "mobile:check": "tsx scripts/mobile-config.ts check",
    "mobile:android:debug": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "mobile:android:aab": "npm run mobile:check -- --release && npm run mobile:sync && cd android && ./gradlew bundleRelease",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "server:migrate-check": "tsx server/migrate-check.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@fontsource/orbitron": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-node": "6.0.0",
    "vitest": "5.0.3"
  }
}
