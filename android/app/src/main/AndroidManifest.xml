<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissions : INTERNET (service du jeu) ; le SDK Google Mobile Ads fusionne celles qui lui sont nécessaires (état du réseau, identifiant publicitaire
         AD_ID). Ni statistiques, ni micro, ni caméra, ni position, ni stockage.
         Orientation : portrait sur téléphone (userPortrait). Avec targetSdk 36, Android ignore ce verrouillage sur les écrans larges
         (tablettes, pliables ≥ 600 dp) : le jeu s'y adapte (mise en page responsive testée en portrait comme en paysage). -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="userPortrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AdMob : ID d'application (identifiant PUBLIC) + configuration du plugin PolarRiftAds, générés depuis mobile/ads.json (android/app/build.gradle).
             Sans cet ID valide le SDK plante au démarrage : le mode « demo » (défaut) fournit l'ID d'exemple officiel de Google. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${polarRiftAdMobAppId}" />
        <meta-data android:name="polarrift.ads.mode" android:value="${polarRiftAdsMode}" />
        <meta-data android:name="polarrift.ads.rewardedUnitId" android:value="${polarRiftAdsRewardedUnit}" />
        <meta-data android:name="polarrift.ads.testDevices" android:value="${polarRiftAdsTestDevices}" />
        <meta-data android:name="polarrift.ads.umpGeography" android:value="${polarRiftAdsUmpGeography}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
