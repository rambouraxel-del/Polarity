# Configuration d'UNE instance du classement. Copier en « .env » (même dossier que docker-compose.yml) puis remplir.
# Ce fichier .env contient un SECRET : il ne doit JAMAIS être committé (il est ignoré par git) ni collé dans un message, une issue ou un chat.
# Une instance = un secret, une base, un domaine. Bêta et production sont deux instances distinctes (voir docs/GUIDE_DEPLOIEMENT.md).

# Nom du projet Docker (change le nom des volumes : « polar-rift-prod », « polar-rift-beta »…)
COMPOSE_PROJECT_NAME=polar-rift-prod

# Domaine public du service (enregistrement DNS A/AAAA vers ce serveur) — sans https://
LEADERBOARD_DOMAIN=classement.exemple.org

# Secret de signature des tickets : 64 caractères aléatoires, propres à cette instance.  Générer :  openssl rand -hex 32
# Changer ce secret invalide les tickets en cours (les joueurs en reçoivent de nouveaux) ; il ne touche ni les profils ni les records.
TICKET_SECRET=

# Origine(s) du jeu autorisée(s) (CORS), séparées par des virgules, exactes, sans chemin ni « / » final, jamais de joker.
# - GitHub Pages : https://<utilisateur>.github.io  (l'origine est le domaine, pas l'adresse complète du dépôt)
# - Applications Android / iOS (Capacitor 8, valeurs épinglées dans capacitor.config.ts) : https://localhost  (Android)  et  capacitor://localhost  (iOS)
#   À ajouter SEULEMENT si vous publiez les applications natives (docs/BUILD_MOBILE.md §« Classement et origines »).
ALLOWED_ORIGINS=https://utilisateur.github.io,https://localhost,capacitor://localhost

# Facultatif : mots interdits supplémentaires dans les pseudos (virgules)
BLOCKED_WORDS=

# Facultatif : plafond global de parties rejouées par minute (protège le processeur ; 30 par défaut)
MAX_REPLAYS_PER_MINUTE=30

# ——— Comptes joueurs (économie v3) — TOUT est facultatif : une méthode sans configuration reste désactivée (voir docs/COMPTES.md)
# Identifiants CLIENTS OAuth (publics par nature, pas des secrets), séparés par des virgules : web, Android, iOS.
GOOGLE_CLIENT_IDS=
# Identifiant « web » transmis au navigateur (par défaut : le premier de la liste)
GOOGLE_WEB_CLIENT_ID=
# Apple : identifiant de service (web) et identifiant d'application (iOS)
APPLE_CLIENT_IDS=
APPLE_WEB_CLIENT_ID=
# Lien magique par courriel (service Resend) : clé d'API = SECRET, expéditeur vérifié chez le fournisseur
RESEND_API_KEY=
MAIL_FROM=
# Adresse publique du jeu (https), utilisée dans le lien du courriel, ex. https://utilisateur.github.io/Polarity/
APP_PUBLIC_URL=
